# Per-customer Kanboard variables. Copy the ones you need into the VM's
# docker.env (next to docker-compose.abi-api.yml). Kanboard is opt-in: it only
# starts when COMPOSE_PROFILES includes "kanban".

# Enable the Kanboard service stack
COMPOSE_PROFILES=kanban

# Cloudflare Access gate (cf-access-verifier). Get the AUD from your CF Access
# app (Application Audience / AUD). Leave ENFORCE=false during rollout to log
# without blocking; flip to true to enforce.
KANBOARD_CF_TEAM=opteia
KANBOARD_CF_APP_AUD=
KANBOARD_ENFORCE=false

# Host port for the nginx proxy (the cloudflared tunnel / LAN points here).
KANBOARD_PROXY_PORT=8096

# DB overrides (optional). Defaults: host=abi-memory-db, port=5432, name=kanboard,
# user=abi_agent, password=$ABI_DB_PASSWORD (shared with abi-memory).
# KANBOARD_DB_HOST=abi-memory-db
# KANBOARD_DB_PORT=5432
# KANBOARD_DB_NAME=kanboard
