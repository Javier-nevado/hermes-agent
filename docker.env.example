# docker.env — secrets + per-customer config for docker-compose.abi-api.yml.
# Copy to `docker.env` (gitignored) next to the compose file. NEVER commit real
# values. Loaded via `docker compose --env-file docker.env`.

# ---- Core (required) ----
ABI_DB_USER=abi_agent
ABI_DB_PASSWORD=            # strong per-deployment password
ABI_DB_NAME=abi_memory
OPTEIA_LICENSE_KEY=         # customer license key (api.opteia.com)
LICENSE_JWT_SECRET=         # HMAC secret shared with the license worker

# ---- Opt-in services ----
# Enable Kanboard (task board). See kanboard/docker.env.example for its vars.
# COMPOSE_PROFILES=kanban
# KANBOARD_CF_TEAM=opteia
# KANBOARD_CF_APP_AUD=
# KANBOARD_ENFORCE=false
# KANBOARD_PROXY_PORT=8096
