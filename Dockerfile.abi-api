FROM python:3.12-slim

LABEL maintainer="Opteia"
LABEL description="ABI Memory API Server — FastAPI + ONNX + psycopg2"

WORKDIR /app

# System deps for psycopg2 and ONNX
RUN apt-get update && \
    apt-get install -y --no-install-recommends libpq-dev gcc && \
    rm -rf /var/lib/apt/lists/*

# Copy dependency files first (cache layer)
COPY pyproject.toml ./

# Install Python deps
RUN pip install --no-cache-dir \
    fastapi[standard] \
    psycopg2-binary \
    onnxruntime \
    tokenizers \
    numpy \
    httpx \
    pydantic \
    PyJWT[crypto]==2.12.1 \
    cryptography>=44.0.0

# Copy ABI code
COPY abi/ ./abi/
COPY plugins/ ./plugins/

# Non-root user for security
RUN useradd -m -u 1000 abiapi
USER abiapi

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8010/health')" || exit 1

EXPOSE 8010

CMD ["uvicorn", "abi.api.main:app", "--host", "0.0.0.0", "--port", "8010", "--workers", "1"]
