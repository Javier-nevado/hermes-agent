# Per-customer vault env — generated by provision-vault.sh <customer>.
# This file holds SECRETS — chmod 600, never commit.

# Public hostname (baked into the instance's OpenPGP identity — set once).
VAULT_HOST=brian.vaults.opteia.com

# MariaDB root password (generated).
VAULT_DB_ROOT=CHANGE_ME_long_random

# Dedicated passbolt app-user password (generated).
VAULT_DB_PASS=CHANGE_ME_long_random

# Cloudflare tunnel token for THIS customer's tunnel (created by provision-vault.sh
# via the Cloudflare API on the opteia.com zone). One tunnel + token per customer.
CLOUDFLARED_TOKEN=CHANGE_ME_tunnel_token

# Brevo SMTP (shared across customers; optional — setup links come from cake stdout).
BREVO_SMTP_USER=
BREVO_SMTP_KEY=
