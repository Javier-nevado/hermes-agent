#!/usr/bin/env python3
"""ABI Dreamer wrapper — ensures correct Python path and venv.

Usage:
    sudo scripts/abi-dreamer              # All agents
    sudo scripts/abi-dreamer --dry-run     # Preview
    sudo scripts/abi-dreamer --agent atlas  # Single agent
"""

import sys
from pathlib import Path

REPO = Path(__file__).parent.parent
sys.path.insert(0, str(REPO))

from abi.dreamer.__main__ import main

if __name__ == "__main__":
    main()
