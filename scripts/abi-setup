#!/usr/bin/env bash
# ABI Platform Setup — one-command bootstrap for fresh installs.
#
# Usage:
#   sudo bash scripts/abi-setup                              # bare-metal (local Postgres)
#   ABI_DATABASE_URL=postgresql://u:p@host:5432/db \
#       ABI_DB_USER=u bash scripts/abi-setup --skip-deps      # container/remote Postgres
#   sudo bash scripts/abi-setup --skip-db --skip-deps         # DB already provisioned
#
# What it does:
#   1. Install Python dependencies (psycopg2-binary, sentence-transformers)
#   2. PostgreSQL: pgvector ext + (bare-metal) create database/user
#   3. Run schema migrations  (abi/sql/[0-9][0-9][0-9]_*.sql, sorted)
#   4. Grant permissions / set table ownership
#   5. Backfill tsvector for existing memories
#   6. Verify
#
# Connection modes:
#   - Bare-metal (default): connects via `sudo -u postgres psql`; creates the
#     database, user, and pgvector extension (needs the OS `postgres` user).
#   - Container/remote: set ABI_DATABASE_URL. Connects through that URL and
#     assumes the database + user already exist (typical for a Docker pgvector
#     container). Only ensures the pgvector extension exists in the target DB.
#
# Environment:
#   ABI_DATABASE_URL  libpq URL  -> container/remote mode
#   ABI_DB_NAME       DB name    (bare-metal default: abi_memory)
#   ABI_DB_USER       DB role    (default: abi_agent; used for grants + 004 schema)
#   ABI_DB_PASS       DB password (bare-metal user creation only)

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DB_NAME="${ABI_DB_NAME:-abi_memory}"
DB_USER="${ABI_DB_USER:-abi_agent}"
DB_PASS="${ABI_DB_PASS:-abi_local_dev_2026}"
SKIP_DB=false
SKIP_DEPS=false

for arg in "$@"; do
    case "$arg" in
        --skip-db)   SKIP_DB=true ;;
        --skip-deps) SKIP_DEPS=true ;;
        --help|-h)
            sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
    esac
done

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
fail() { echo -e "${RED}[FAIL]${NC} $*"; exit 1; }

# ── Resolve psql connection ──────────────────────────────────────
# PSQL_DB = command prefix that connects to the TARGET database.
if [ -n "${ABI_DATABASE_URL:-}" ]; then
    CONTAINER_MODE=true
    PSQL_DB=(psql -v ON_ERROR_STOP=1 "$ABI_DATABASE_URL")
else
    CONTAINER_MODE=false
    PSQL_DB=(sudo -u postgres psql -v ON_ERROR_STOP=1 -d "$DB_NAME")
fi

echo "=== ABI Platform Setup ==="
echo "Repo: $REPO_DIR"
if [ "$CONTAINER_MODE" = true ]; then
    echo "Mode: container/remote (ABI_DATABASE_URL)"
else
    echo "Mode: bare-metal (sudo -u postgres)"
fi
echo ""

# ── 1. Dependencies ──────────────────────────────────────────────
if [ "$SKIP_DEPS" = false ]; then
    echo "── Step 1: Installing Python dependencies ──"
    UV="$(command -v uv || echo "$HOME/.local/bin/uv")"
    if [ ! -x "$UV" ]; then
        warn "uv not found, installing..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        UV="$HOME/.local/bin/uv"
    fi
    "$UV" pip install --python "$REPO_DIR/.venv/bin/python3" \
        "psycopg2-binary==2.9.12" \
        "sentence-transformers==5.5.1" 2>&1 | tail -3
    ok "Dependencies installed"
else
    echo "── Step 1: Skipped (--skip-deps) ──"
fi

# ── 2. PostgreSQL ────────────────────────────────────────────────
echo ""
echo "── Step 2: PostgreSQL setup ──"
if [ "$SKIP_DB" = false ] && [ "$CONTAINER_MODE" = false ]; then
    # Bare-metal: ensure pgvector extension + create database/user.
    if sudo -u postgres psql -d postgres -c "SELECT 1 FROM pg_extension WHERE extname='vector'" -tAc | grep -q 1; then
        ok "pgvector extension installed"
    else
        warn "Installing pgvector extension..."
        sudo -u postgres psql -d postgres -c "CREATE EXTENSION IF NOT EXISTS vector" || \
            fail "pgvector extension not available. Install: apt install postgresql-\$(psql -V | grep -oP '\\d+' | head -1)-pgvector"
        ok "pgvector extension installed"
    fi

    if sudo -u postgres psql -lqt | cut -d '|' -f 1 | grep -qw "$DB_NAME"; then
        ok "Database '$DB_NAME' exists"
    else
        sudo -u postgres psql -c "CREATE USER $DB_USER WITH PASSWORD '$DB_PASS'"
        sudo -u postgres psql -c "CREATE DATABASE $DB_NAME OWNER $DB_USER"
        sudo -u postgres psql -d "$DB_NAME" -c "CREATE EXTENSION IF NOT EXISTS vector"
        ok "Database '$DB_NAME' created"
    fi
    sudo -u postgres psql -d "$DB_NAME" -c "GRANT USAGE ON EXTENSION vector TO $DB_USER" 2>/dev/null || true
elif [ "$CONTAINER_MODE" = true ]; then
    # Container/remote: assume DB + user exist; just ensure pgvector in target DB.
    if "${PSQL_DB[@]}" -c "CREATE EXTENSION IF NOT EXISTS vector" >/dev/null 2>&1; then
        ok "pgvector extension ready in target DB"
    else
        warn "Could not CREATE EXTENSION vector (need superuser) — enable it manually, then re-run"
    fi
fi

# ── 3. Schema Migrations ─────────────────────────────────────────
echo ""
echo "── Step 3: Schema migrations ──"
shopt -s nullglob
migrations=( $(printf '%s\n' "$REPO_DIR"/abi/sql/[0-9][0-9][0-9]_*.sql | sort) )
shopt -u nullglob
if [ "${#migrations[@]}" -eq 0 ]; then
    warn "No migration files found in $REPO_DIR/abi/sql/"
else
    for migration in "${migrations[@]}"; do
        if "${PSQL_DB[@]}" -v db_user="$DB_USER" -f "$migration"; then
            ok "Applied $(basename "$migration")"
        else
            fail "Migration failed: $(basename "$migration")"
        fi
    done
fi

# ── 4. Permissions / ownership ───────────────────────────────────
echo ""
echo "── Step 4: Permissions ──"
"${PSQL_DB[@]}" -v db_user="$DB_USER" <<SQL
GRANT ALL ON ALL TABLES IN SCHEMA public TO $DB_USER;
GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO $DB_USER;
ALTER TABLE IF EXISTS abi_memories        OWNER TO $DB_USER;
ALTER TABLE IF EXISTS abi_agents          OWNER TO $DB_USER;
ALTER TABLE IF EXISTS abi_entities        OWNER TO $DB_USER;
ALTER TABLE IF EXISTS abi_edges           OWNER TO $DB_USER;
ALTER TABLE IF EXISTS abi_memory_entities OWNER TO $DB_USER;
SQL
ok "Permissions granted"

# ── 5. Backfill tsvector ─────────────────────────────────────────
echo ""
echo "── Step 5: tsvector backfill ──"
COUNT=$("${PSQL_DB[@]}" -tAc "SELECT count(*) FROM abi_memories WHERE fts IS NULL" | tr -d '[:space:]')
if [ "${COUNT:-0}" -gt 0 ]; then
    "${PSQL_DB[@]}" -c "UPDATE abi_memories SET fts = to_tsvector('english', COALESCE(content, '')) WHERE fts IS NULL"
    ok "Backfilled tsvector for $COUNT memories"
else
    ok "All memories have tsvector (no backfill needed)"
fi

# ── 6. Verify ────────────────────────────────────────────────────
echo ""
echo "── Step 6: Verification ──"
PY="$REPO_DIR/.venv/bin/python3"
if [ -x "$PY" ]; then
    "$PY" -c "
from abi.memory.entities import EntityExtractor
from abi.memory.provider import ABIMemoryProvider
from abi.memory.embeddings import get_embedding
print('  All ABI modules import OK')
" 2>&1 || warn "Some imports failed — check .venv has sentence-transformers"
else
    warn "No .venv python at $PY — skipping Python verification"
fi

TABLES=$("${PSQL_DB[@]}" -tAc "
    SELECT count(*) FROM information_schema.tables
    WHERE table_name IN ('abi_memories','abi_agents','abi_entities','abi_edges','abi_memory_entities')
" | tr -d '[:space:]')
if [ "${TABLES:-0}" -eq 5 ]; then
    ok "All 5 core tables present"
else
    warn "Expected 5 core tables, found ${TABLES:-0}"
fi

# Show the embedding index type (sanity: should be hnsw)
IDXDEF=$("${PSQL_DB[@]}" -tAc "SELECT indexdef FROM pg_indexes WHERE tablename='abi_memories' AND indexname='idx_abi_memories_embedding'" 2>/dev/null | tr -d '[:space:]' || true)
case "$IDXDEF" in
    *USINGhnsw*)    ok "embedding index type: hnsw" ;;
    *USINGivfflat*) warn "embedding index type: ivfflat (expected hnsw)" ;;
    "")             warn "idx_abi_memories_embedding not found" ;;
    *)              warn "embedding index type: unknown" ;;
esac

echo ""
echo "=== Setup Complete ==="
echo ""
echo "Next steps:"
echo "  1. Provision agents:  sudo bash scripts/abi-provision"
echo "  2. Run health check:  sudo bash scripts/abi-health"
echo "  3. Test recall:       .venv/bin/python3 scripts/abi-dreamer --dry-run"
echo ""
