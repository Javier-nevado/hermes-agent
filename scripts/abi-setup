#!/usr/bin/env bash
# ABI Platform Setup — one-command bootstrap for fresh installs
# Usage: sudo bash scripts/abi-setup [--skip-db] [--skip-deps]
#
# What it does:
#   1. Install Python dependencies (psycopg2-binary, sentence-transformers)
#   2. Create PostgreSQL database + user (if not exists)
#   3. Run schema migrations
#   4. Grant permissions
#   5. Backfill tsvector for existing memories
#   6. Verify everything works
#
# Prerequisites:
#   - PostgreSQL 14+ with pgvector extension
#   - Python 3.11+
#   - uv package manager (pip install uv)

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
DB_NAME="${ABI_DB_NAME:-abi_memory}"
DB_USER="${ABI_DB_USER:-abi_agent}"
DB_PASS="${ABI_DB_PASS:-abi_local_dev_2026}"
SKIP_DB=false
SKIP_DEPS=false

for arg in "$@"; do
    case "$arg" in
        --skip-db)   SKIP_DB=true ;;
        --skip-deps) SKIP_DEPS=true ;;
        --help|-h)
            echo "Usage: sudo bash scripts/abi-setup [--skip-db] [--skip-deps]"
            echo ""
            echo "  --skip-db    Skip PostgreSQL setup (DB already configured)"
            echo "  --skip-deps  Skip pip install (deps already installed)"
            exit 0
            ;;
    esac
done

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

ok()   { echo -e "${GREEN}[OK]${NC} $*"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
fail() { echo -e "${RED}[FAIL]${NC} $*"; exit 1; }

echo "=== ABI Platform Setup ==="
echo "Repo: $REPO_DIR"
echo ""

# ── 1. Dependencies ──────────────────────────────────────────────
if [ "$SKIP_DEPS" = false ]; then
    echo "── Step 1: Installing Python dependencies ──"
    UV="$(command -v uv || echo "$HOME/.local/bin/uv")"
    if [ ! -x "$UV" ]; then
        warn "uv not found, installing..."
        curl -LsSf https://astral.sh/uv/install.sh | sh
        UV="$HOME/.local/bin/uv"
    fi
    "$UV" pip install --python "$REPO_DIR/.venv/bin/python3" \
        "psycopg2-binary==2.9.12" \
        "sentence-transformers==5.5.1" 2>&1 | tail -3
    ok "Dependencies installed"
else
    echo "── Step 1: Skipped (--skip-deps) ──"
fi

# ── 2. PostgreSQL ────────────────────────────────────────────────
if [ "$SKIP_DB" = false ]; then
    echo ""
    echo "── Step 2: PostgreSQL setup ──"

    # Check pgvector extension
    if sudo -u postgres psql -d postgres -c "SELECT 1 FROM pg_extension WHERE extname='vector'" -tAc | grep -q 1; then
        ok "pgvector extension installed"
    else
        warn "Installing pgvector extension..."
        sudo -u postgres psql -d postgres -c "CREATE EXTENSION IF NOT EXISTS vector" || \
            fail "pgvector extension not available. Install: apt install postgresql-\$(psql -V | grep -oP '\\d+' | head -1)-pgvector"
        ok "pgvector extension installed"
    fi

    # Create database + user
    if sudo -u postgres psql -lqt | cut -d '|' -f 1 | grep -qw "$DB_NAME"; then
        ok "Database '$DB_NAME' exists"
    else
        sudo -u postgres psql -c "CREATE USER $DB_USER WITH PASSWORD '$DB_PASS'"
        sudo -u postgres psql -c "CREATE DATABASE $DB_NAME OWNER $DB_USER"
        sudo -u postgres psql -d "$DB_NAME" -c "CREATE EXTENSION IF NOT EXISTS vector"
        ok "Database '$DB_NAME' created"
    fi

    # Grant pgvector usage
    sudo -u postgres psql -d "$DB_NAME" -c "GRANT USAGE ON EXTENSION vector TO $DB_USER" 2>/dev/null || true
fi

# ── 3. Schema Migrations ─────────────────────────────────────────
echo ""
echo "── Step 3: Schema migrations ──"

# Migration 001: abi_memories table (inline — was created before file-based migrations)
if sudo -u postgres psql -d "$DB_NAME" -c "SELECT 1 FROM abi_memories LIMIT 0" 2>/dev/null; then
    ok "abi_memories table exists"
else
    sudo -u postgres psql -d "$DB_NAME" << 'SQL'
CREATE TABLE IF NOT EXISTS abi_memories (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    content TEXT NOT NULL,
    embedding vector(384),
    dlp_level TEXT NOT NULL DEFAULT 'internal'
        CHECK (dlp_level IN ('public', 'internal', 'confidential')),
    agent_name TEXT NOT NULL,
    user_id TEXT,
    source_type TEXT DEFAULT 'agent_tool',
    metadata JSONB DEFAULT '{}',
    created_at TIMESTAMPTZ DEFAULT NOW(),
    fts tsvector
);
CREATE INDEX IF NOT EXISTS idx_abi_memories_embedding ON abi_memories USING ivfflat (embedding vector_cosine_ops) WITH (lists = 100);
CREATE INDEX IF NOT EXISTS idx_abi_memories_fts ON abi_memories USING GIN(fts);
SQL
    ok "abi_memories table created"
fi

# Migration 002: abi_agents table
for migration in "$REPO_DIR"/abi/sql/002_*.sql; do
    if [ -f "$migration" ]; then
        sudo -u postgres psql -d "$DB_NAME" -f "$migration" 2>&1 | grep -iE 'error|already exists' || true
        ok "Applied $(basename $migration)"
    fi
done

# ── 4. Permissions ───────────────────────────────────────────────
echo ""
echo "── Step 4: Permissions ──"
sudo -u postgres psql -d "$DB_NAME" -c "
    GRANT ALL ON ALL TABLES IN SCHEMA public TO $DB_USER;
    GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO $DB_USER;
    GRANT ALL ON abi_entities, abi_edges, abi_memory_entities, abi_agents TO $DB_USER;
" 2>&1 | grep -iE 'error' || true
ok "Permissions granted"

# ── 5. Backfill tsvector ─────────────────────────────────────────
echo ""
echo "── Step 5: tsvector backfill ──"
COUNT=$(sudo -u postgres psql -d "$DB_NAME" -tAc "SELECT count(*) FROM abi_memories WHERE fts IS NULL")
if [ "$COUNT" -gt 0 ]; then
    sudo -u postgres psql -d "$DB_NAME" -c "UPDATE abi_memories SET fts = to_tsvector('english', COALESCE(content, '')) WHERE fts IS NULL"
    ok "Backfilled tsvector for $COUNT memories"
else
    ok "All memories have tsvector (no backfill needed)"
fi

# ── 6. Verify ────────────────────────────────────────────────────
echo ""
echo "── Step 6: Verification ──"

# Check Python imports
"$REPO_DIR/.venv/bin/python3" -c "
from abi.memory.entities import EntityExtractor
from abi.memory.provider import ABIMemoryProvider
from abi.memory.embeddings import get_embedding
print('  All ABI modules import OK')
" 2>&1 || warn "Some imports failed — check .venv has sentence-transformers"

# Check DB tables
TABLES=$(sudo -u postgres psql -d "$DB_NAME" -tAc "
    SELECT count(*) FROM information_schema.tables
    WHERE table_name IN ('abi_memories','abi_agents','abi_entities','abi_edges','abi_memory_entities')
")
if [ "$TABLES" -eq 5 ]; then
    ok "All 5 tables present"
else
    warn "Expected 5 tables, found $TABLES"
fi

# Check entity extraction
"$REPO_DIR/.venv/bin/python3" -c "
import sys; sys.path.insert(0, '$REPO_DIR')
from abi.memory.entities import EntityExtractor
ext = EntityExtractor()
ents = ext.extract('Javier Nevado is CEO of Opteia Limited, targeting €10K MRR by Q3 2026')
print(f'  Entity extraction: {len(ents)} entities found')
for e in ents:
    print(f'    {e.type}: {e.name}')
" 2>&1

echo ""
echo "=== Setup Complete ==="
echo ""
echo "Next steps:"
echo "  1. Provision agents:  sudo bash scripts/abi-provision"
echo "  2. Run health check:  sudo bash scripts/abi-health"
echo "  3. Test recall:       .venv/bin/python3 scripts/abi-dreamer --dry-run"
echo ""
