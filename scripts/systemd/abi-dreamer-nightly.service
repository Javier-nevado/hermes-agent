[Unit]
Description=ABI Dreamer — nightly memory intelligence (densify; dedup opt-in)
Documentation=https://github.com/Javier-nevado/hermes-agent
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/abi-dreamer-nightly.sh
User=root

# --- Per-box config (uncomment + edit before enabling) ---------------------
# Nightly default is DENSIFY ONLY (safe: in-place rewrite + audit trail).
# Dedup is opt-in + SAFE (3.6.0): soft-delete (superseded_by + valid_to) + a
# dedup_log audit trail, threshold 0.97 calibrated against decrypted pairs
# (>0.97 + telemetry-skip ≈ 0% false positives). Reversible. Enable per-box after
# sign-off. extract-llm (LLM egress) is separate + also opt-in.
# Environment="ABI_DREAMER_DEDUP=1"
#
# Space-separated agents to densify on the host (each uses its own LLM).
# If unset, the wrapper discovers active agents from the abi-memory-api DB.
# Environment="ABI_DENSIFY_AGENTS=atlas iris sol ailean vera caspian jen"
#
# Override the densify model (keeps each agent's hermes client/provider+key).
# Validated on .19: glm-4.7-flash (fast REASONING model -- reasoning models
# isolate chain-of-thought into reasoning_content, leaving `content` as clean
# JSON; non-reasoning models like glm-4.5-air dump CoT into content and flake).
# Environment="ABI_DENSIFY_MODEL=glm-4.7-flash"
#
# Batch size (memories per LLM call). 5 keeps reasoning-CoT + JSON within the
# 4k token budget (low parse-error rate on long memories).
# Environment="ABI_DENSIFY_BATCH=5"
#
# Host python with openai + the hermes source tree (default below; some
# customer VMs use /opt/hermes-gateway/.venv/bin/python3).
# Environment="HERMES_PYTHON=/opt/hermes-agent/.venv/bin/python3"
# Environment="HERMES_PACKAGE_ROOT=/opt/hermes-agent"

# journald; the dreamer also prints a per-agent summary to stdout.
StandardOutput=journal
StandardError=journal
