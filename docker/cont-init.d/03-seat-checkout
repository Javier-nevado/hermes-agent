#!/command/with-contenv sh
# shellcheck shell=sh
# ABI v4 seat-licensing hard gate.
#
# Runs as root after 01-hermes-setup (stage2) and before s6-rc starts user
# services. When ABI_SEAT_GATE=1, checks out a licensed seat; on failure it exits
# non-zero -> cont-init fails -> s6 does not bring up the gateway -> the agent
# cannot run without a licensed seat (compose Restart retries, but it won't boot
# until a seat frees or the license is fixed).
#
# Opt-in: ABI_SEAT_GATE defaults to 0, so the image runs ungated until the Worker
# seat routes ship (Phase 0-C) — preserves v3 parity in the meantime.
#
# Uses the image's product python (/opt/hermes/.venv/bin/python) directly: the
# gate is stdlib-only and must run before the per-agent volume venv is relied on.
set -eu

if [ "${ABI_SEAT_GATE:-0}" != "1" ]; then
    echo "[seat] ABI_SEAT_GATE not set to 1 — seat gate OFF (pre-license-api parity)"
    exit 0
fi

PY=/opt/hermes/.venv/bin/python
GATE=/opt/hermes/docker/abi-seat-gate.py

if [ ! -f "$GATE" ]; then
    echo "[seat] $GATE missing — cannot enforce seat gate; refusing to start" >&2
    exit 1
fi

if ! "$PY" "$GATE" checkout; then
    rc=$?
    echo "[seat] checkout FAILED (rc=$rc) — refusing to start the gateway" >&2
    exit "$rc"
fi

# Heartbeat: a detached process that renews the seat for the container lifetime,
# releases it on SIGTERM (best-effort — `setsid` puts it in its own session, so
# whether the container-stop signal reaches it depends on KillMode), and tears
# down the supervised services on seat loss so the agent stops running seatless.
# The GUARANTEED reclaim path is the Worker's heartbeat-TTL sweep (a crashed/
# killed agent's seat expires and is freed) — graceful release is an optimization.
# Full s6-rc longrun integration (tracked service + finish script) is a Phase 1
# refinement that makes the graceful release reliable.
setsid "$PY" "$GATE" heartbeat >/dev/null 2>&1 &
echo "[seat] heartbeat loop started (pid $!)"
